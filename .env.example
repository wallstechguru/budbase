PORT=3000
SESSION_SECRET=change-me
NODE_ENV=development

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used only in production for persistent
# sessions (Project Settings -> Database -> Connection string). Leave blank
# locally — sessions just live in memory during dev.
DATABASE_URL=

# Order notification email. Leave blank to log orders to the console instead.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ORDER_NOTIFY_EMAIL=
