<div class="mobile-nav-overlay" id="mobile-nav-overlay"></div>
<nav class="mobile-nav" id="mobile-nav" aria-label="Mobile">
  <div class="mobile-nav__header">
    <img src="/images/logo.svg" alt="BudBase" height="28">
    <button type="button" class="icon-btn" id="mobile-nav-close" aria-label="Close menu">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <div class="mobile-nav__section">
    <span class="mobile-nav__label">Shop</span>
    <ul>
      <% categories.forEach(function(c) { %>
        <li><a href="/shop/<%= c.slug %>"><%= c.name %></a></li>
      <% }) %>
    </ul>
    <a href="/shop" class="mobile-nav__all">Shop all products &rarr;</a>
  </div>

  <div class="mobile-nav__section">
    <ul>
      <li><a href="/deals">Deals</a></li>
      <li><a href="/locations">Locations</a></li>
      <li><a href="/recycling">Recycling Initiative</a></li>
    </ul>
  </div>

  <div class="mobile-nav__section">
    <ul>
      <li><a href="<%= currentUser ? '/account' : '/account/login' %>"><%= currentUser ? 'My Account' : 'Log In' %></a></li>
      <% if (currentUser && currentUser.is_admin) { %>
        <li><a href="/admin">Admin Dashboard</a></li>
      <% } %>
      <li><a href="/contact">Contact Us</a></li>
    </ul>
  </div>
</nav>
