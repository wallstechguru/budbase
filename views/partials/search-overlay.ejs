<div class="search-overlay-backdrop" id="search-backdrop"></div>
<div class="search-panel" id="search-panel">
  <form action="/search" method="GET" class="search-panel__form">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="search" name="q" id="search-input" placeholder="Search products, brands, categories" autocomplete="off" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
    <button type="button" class="icon-btn" id="search-close" aria-label="Close search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </form>
</div>
