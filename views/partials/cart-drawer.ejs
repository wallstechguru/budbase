<div class="cart-drawer-overlay" id="cart-drawer-overlay"></div>
<aside class="cart-drawer" id="cart-drawer" aria-label="Shopping cart">
  <div class="cart-drawer__header">
    <h3>Your Cart</h3>
    <button type="button" class="icon-btn" id="cart-drawer-close" aria-label="Close cart">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="cart-drawer__body" id="cart-drawer-body">
    <%- include('cart-drawer-items', { cartItems: cartItems, cartSubtotal: cartSubtotal }) %>
  </div>
</aside>
