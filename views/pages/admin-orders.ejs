<!doctype html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/account.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <%- include('../partials/age-gate') %>
  <%- include('../partials/header') %>
  <%- include('../partials/cart-drawer') %>

  <main>
    <div class="container admin-page">
      <%- include('../partials/admin-nav', { activeAdminTab: 'orders' }) %>

      <div class="admin-page__head">
        <h1>Orders</h1>
      </div>

      <% if (!orders.length) { %>
        <p class="admin-empty">No orders yet.</p>
      <% } else { %>
        <div class="order-list order-list--admin">
          <% orders.forEach(function(order) { %>
            <a href="/admin/orders/<%= order.id %>" class="order-card order-card--link">
              <div class="order-card__head">
                <div>
                  <strong>Order #<%= order.id %></strong>
                  <span class="order-card__date"><%= new Date(order.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
                </div>
                <span class="order-card__status"><%= order.status.replace(/_/g, ' ') %></span>
              </div>

              <div class="order-card__customer">
                <strong><%= order.full_name %></strong> &lt;<%= order.email %>&gt;
                <span class="admin-table__sub"><%= order.address %></span>
                <span class="admin-table__sub"><%= order.payment_method.replace(/_/g, ' ') %><%= order.crypto_network ? ' (' + order.crypto_network.toUpperCase() + ')' : '' %></span>
              </div>

              <ul class="order-card__items">
                <% order.items.forEach(function(item) { %>
                  <li><%= item.quantity %> &times; <%= item.product_name %> <em><%= item.size_label %></em></li>
                <% }) %>
              </ul>

              <div class="order-card__foot">
                <span>Total</span>
                <strong><%= formatPrice(order.subtotal) %></strong>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/cart-drawer.js" defer></script>
</body>
</html>
