<!doctype html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/checkout.css">
  <link rel="stylesheet" href="/css/account.css">
</head>
<body>
  <%- include('../partials/age-gate') %>
  <%- include('../partials/header') %>
  <%- include('../partials/cart-drawer') %>

  <main>
    <div class="container auth-page">
      <div class="auth-card">
        <h1>Change Password</h1>

        <% if (notice) { %>
          <div class="admin-notice"><%= notice %></div>
        <% } %>
        <% if (errors) { %>
          <div class="form-errors">
            <ul>
              <% errors.forEach(function(e) { %><li><%= e %></li><% }) %>
            </ul>
          </div>
        <% } %>

        <form method="POST" action="/account/password">
          <div class="form-row">
            <label>Current Password
              <input type="password" name="current_password" required>
            </label>
          </div>
          <div class="form-row">
            <label>New Password
              <input type="password" name="new_password" required minlength="8">
            </label>
          </div>
          <div class="form-row">
            <label>Confirm New Password
              <input type="password" name="confirm_password" required minlength="8">
            </label>
          </div>
          <button type="submit" class="btn btn-primary auth-card__submit">Update Password</button>
        </form>

        <p class="auth-card__switch"><a href="/account">Back to My Account</a></p>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/cart-drawer.js" defer></script>
</body>
</html>
