<!doctype html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/hero.css">
  <link rel="stylesheet" href="/css/categories.css">
</head>
<body>
  <%- include('../partials/age-gate') %>
  <%- include('../partials/header') %>
  <%- include('../partials/cart-drawer') %>

  <main>
    <section class="hero-banners container">
      <div class="hero-banners__grid">
        <a href="/rewards" class="promo-card promo-card--rewards">
          <span class="promo-card__eyebrow">Base<br>Rewards</span>
          <span class="promo-card__body">
            <p>Member pricing on every order.</p>
            <span class="promo-card__cta">Member pricing
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </span>
        </a>

        <a href="/deals" class="promo-card promo-card--deal">
          <span class="promo-card__eyebrow">Deal<br>Days</span>
          <span class="promo-card__body">
            <p>Every Wednesday, select favourites from £5.</p>
            <span class="promo-card__cta">Shop Deal Days
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </span>
        </a>

        <a href="/shop" class="promo-card promo-card--new">
          <span class="promo-card__eyebrow">New<br>In</span>
          <span class="promo-card__body">
            <p>Fresh drops just landed.</p>
            <span class="promo-card__cta">Shop fresh drops
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </span>
        </a>

        <a href="/shop/vapes" class="promo-card promo-card--vapes">
          <span class="promo-card__eyebrow">Vapes<br>Under £30</span>
          <span class="promo-card__body">
            <p>Puff without the price tag.</p>
            <span class="promo-card__cta">Choose your vape
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </span>
        </a>
      </div>
    </section>

    <section class="collections container">
      <div class="collections__header">
        <h2>Collections</h2>
      </div>
      <div class="collections__scroller">
        <% categories.forEach(function(c) { %>
          <a href="/shop/<%= c.slug %>" class="collection-tile">
            <span class="collection-tile__image">
              <img src="/images/products/<%= c.tile_image %>" alt="<%= c.name %>">
            </span>
            <span class="collection-tile__label">
              <%= c.name %>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </a>
        <% }) %>
      </div>
    </section>

    <section class="collections container">
      <div class="collections__header">
        <h2>Featured</h2>
        <a href="/shop" class="promo-card__cta" style="color: var(--color-forest-700);">Shop all
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
      <div class="product-grid">
        <% featuredProducts.forEach(function(product) { %>
          <%- include('../partials/product-card', { product: product }) %>
        <% }) %>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/cart-drawer.js" defer></script>
</body>
</html>
